# Database Configuration
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/casaas_db?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="super-secret-access-token-key-32-chars-min"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-32-chars-min"
ACCESS_TOKEN_EXPIRES="15m"
REFRESH_TOKEN_EXPIRES="7d"

# WhatsApp Integration Configuration
WHATSAPP_PROVIDER="mock" # Set to "cloud" for Meta Cloud API
WHATSAPP_ACCESS_TOKEN="mock_whatsapp_access_token"
WHATSAPP_PHONE_NUMBER_ID="100200300400"
WHATSAPP_VERIFY_TOKEN="casaas_verify_token_123"

# AI / Gemini Configuration (backend only — never expose to the frontend)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_TIMEOUT_MS="45000"

# Storage & MinIO Configuration
STORAGE_PROVIDER="local"
MINIO_ENDPOINT="localhost"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadminpassword"
MINIO_BUCKET="casaas-docs"

# Application URLs
APP_URL="http://localhost:3000"
API_URL="http://localhost:5000"
